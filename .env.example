# Kilitli (gated) modeller (örn. meta-llama/*) için gerekli.
# https://huggingface.co/settings/tokens adresinden "Read" yetkili bir anahtar oluştur,
# model sayfasında lisansı kabul et ve bu dosyayı .env olarak kopyala.
HF_TOKEN=

# İsteğe bağlı: tokenizer.json önbellek klasörü (varsayılan: ./.cache)
# TOKENIZER_CACHE_DIR=
